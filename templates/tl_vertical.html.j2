<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ q.id }} — {{ q.titre }} · TL</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,600;1,9..40,300&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  /* TL vertical — design ref 1080×1920 — fluide responsive */
  :root {
    --bg: #080A0F;
    --bg2: #0E1117;
    --bg3: #141820;
    --teal: #00D4B4;
    --teal-dim: #00A890;
    --gold: #F0B429;
    --gold-dim: #C48F1A;
    --white: #F0EDE8;
    --muted: #6B7280;

    --font-display: 'Bebas Neue', sans-serif;
    --font-body: 'DM Sans', sans-serif;
    --font-mono: 'Space Mono', monospace;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; min-width: 0; }

  html, body {
    max-width: 100vw;
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--white);
    font-family: var(--font-body);
    font-size: clamp(14px, 3.5vw, 26px);
    line-height: 1.4;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  img { max-width: 100%; height: auto; display: block; }

  section[data-snap="true"] {
    width: 100%;
    max-width: 100vw;
    padding: 6vh 6vw;
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2vh, 24px);
    scroll-snap-align: start;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  section[data-snap="true"].visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ==========  SECTION 1 — Hero  ========== */

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .logo-tl {
    width: clamp(48px, 9vw, 88px);
    height: auto;
    object-fit: contain;
  }
  .topbar-meta {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.5vw, 22px);
    color: var(--muted);
    letter-spacing: 2px;
    text-align: right;
    white-space: nowrap;
  }

  [data-zone="header"] {
    display: flex;
    flex-direction: column;
    gap: clamp(4px, 1vh, 12px);
  }
  .questionnaire-tag {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.5vw, 28px);
    letter-spacing: clamp(2px, 1vw, 8px);
    color: var(--muted);
    text-transform: uppercase;
  }
  .code-huge {
    font-family: var(--font-display);
    font-size: clamp(96px, 26vw, 280px);
    line-height: 0.85;
    color: var(--teal);
    letter-spacing: 1px;
  }
  .title-tl {
    font-family: var(--font-display);
    font-size: clamp(26px, 7vw, 72px);
    line-height: 1;
    color: var(--white);
    letter-spacing: 0.5px;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  [data-zone="identity"] {
    background: var(--bg2);
    border: 1px solid rgba(255,255,255,0.07);
    padding: clamp(12px, 2vh, 20px) clamp(14px, 3vw, 28px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(12px, 3vw, 32px);
    row-gap: clamp(6px, 1.2vh, 12px);
  }
  .identity-cell-tl {
    display: flex;
    align-items: baseline;
    gap: clamp(6px, 1.5vw, 12px);
    flex-wrap: wrap;
    min-width: 0;
  }
  .identity-cell-tl .label-tl,
  .identity-cell-tl .value-tl {
    font-size: clamp(13px, 3vw, 24px);
    line-height: 1.2;
  }
  .identity-cell-tl .label-tl {
    font-family: var(--font-mono);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
  .identity-cell-tl .value-tl {
    font-weight: 600;
    color: var(--white);
  }

  [data-zone="hero"] {
    background: var(--bg2);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px;
    padding: clamp(8px, 1.5vh, 16px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-screenshot {
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: contain;
    background: var(--bg2);
    border-radius: 4px;
  }

  [data-zone="frise"] {
    background: var(--bg3);
    padding: clamp(8px, 1.2vh, 12px) clamp(10px, 2.5vw, 20px);
    border-radius: 4px;
  }
  .frise-flow-tl {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(4px, 0.8vw, 8px);
    align-items: center;
  }
  .frise-step-tl {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.2vw, 18px);
    color: var(--muted);
    padding: clamp(2px, 0.5vh, 5px) clamp(5px, 1.2vw, 10px);
    background: var(--bg2);
    border: 1px solid rgba(255,255,255,0.07);
    line-height: 1;
  }
  .frise-step-tl.active {
    color: var(--bg);
    background: var(--teal);
    border-color: var(--teal);
    font-weight: 700;
  }

  /* ==========  SECTION 2 — Disrupteur  ========== */

  .section-disrupteur {
    padding: 10vh 6vw;
  }
  [data-zone="disrupteur"] {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: clamp(8px, 1.5vh, 16px);
  }
  .disrupteur-tag-tl {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.5vw, 28px);
    color: var(--muted);
    letter-spacing: clamp(2px, 1vw, 8px);
    text-transform: uppercase;
  }
  .disrupteur-line {
    font-family: var(--font-display);
    font-size: clamp(64px, 18vw, 220px);
    line-height: 0.95;
    color: var(--gold);
    letter-spacing: 1px;
    word-break: normal;
    overflow-wrap: anywhere;
  }
  .disrupteur-arrow-tl {
    font-family: var(--font-display);
    font-size: clamp(48px, 14vw, 160px);
    color: var(--white);
    line-height: 1;
  }
  .disrupteur-sec-tl {
    font-size: clamp(18px, 5vw, 36px);
    color: var(--muted);
    margin-top: clamp(20px, 4vh, 60px);
    line-height: 1.4;
    max-width: 100%;
  }

  /* ==========  SECTION 3 — Décisions  ========== */

  .section-decisions {
    padding: 8vh 6vw;
  }
  .section-tag {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.5vw, 28px);
    letter-spacing: clamp(2px, 1vw, 8px);
    color: var(--muted);
    text-transform: uppercase;
  }
  .section-title-tl {
    font-family: var(--font-display);
    font-size: clamp(40px, 11vw, 88px);
    line-height: 1;
    color: var(--teal);
    letter-spacing: 0.5px;
    margin-top: clamp(4px, 0.8vh, 12px);
    margin-bottom: clamp(12px, 2vh, 24px);
  }
  .decisions-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.5vh, 14px);
  }
  .decisions-list li {
    background: var(--bg2);
    border-left: clamp(3px, 0.7vw, 6px) solid var(--teal);
    padding: clamp(12px, 2vh, 22px) clamp(14px, 3.5vw, 28px);
    font-size: clamp(16px, 4vw, 28px);
    line-height: 1.3;
    color: var(--white);
  }

  .patient-rappel {
    background: var(--bg3);
    padding: clamp(12px, 2vh, 20px) clamp(14px, 3.5vw, 28px);
    margin-top: clamp(12px, 2vh, 16px);
    border-left: 4px solid var(--muted);
  }
  .patient-rappel-label {
    font-family: var(--font-mono);
    font-size: clamp(10px, 2vw, 18px);
    letter-spacing: 1.5px;
    color: var(--muted);
    text-transform: uppercase;
  }
  .patient-rappel-content {
    font-size: clamp(13px, 3vw, 22px);
    color: var(--white);
    margin-top: 6px;
    line-height: 1.4;
  }

  /* ==========  SECTION 4 — Pourquoi + footer  ========== */

  .section-valeur {
    padding: 8vh 6vw 4vh;
  }
  [data-zone="valeur"] {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: rgba(240, 180, 41, 0.08);
    border-left: clamp(4px, 1vw, 8px) solid var(--gold);
    padding: clamp(20px, 4vh, 40px) clamp(16px, 4vw, 44px);
  }
  [data-zone="valeur"] .valeur-tag {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.5vw, 24px);
    letter-spacing: clamp(2px, 1vw, 6px);
    color: var(--muted);
    text-transform: uppercase;
  }
  [data-zone="valeur"] h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 10vw, 80px);
    line-height: 0.95;
    color: var(--gold);
    margin: clamp(4px, 0.8vh, 8px) 0 clamp(14px, 2.5vh, 28px) 0;
  }
  [data-zone="valeur"] ul {
    list-style: none;
  }
  [data-zone="valeur"] li {
    font-size: clamp(14px, 3.2vw, 26px);
    line-height: 1.4;
    color: var(--white);
    padding: clamp(8px, 1.4vh, 14px) 0;
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  [data-zone="valeur"] li:last-child {
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  [data-zone="valeur"] li.first-point-tl {
    font-family: var(--font-display);
    font-size: clamp(28px, 7vw, 52px);
    line-height: 1.05;
    color: var(--white);
    background: rgba(240, 180, 41, 0.18);
    padding: clamp(14px, 2.5vh, 24px) clamp(14px, 3vw, 28px);
    margin: 0 0 clamp(8px, 1.5vh, 12px) 0;
    border-left: clamp(4px, 1vw, 6px) solid var(--gold);
    border-top: 0;
  }

  [data-zone="footer"] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: clamp(12px, 2vh, 16px);
    margin-top: clamp(12px, 2vh, 24px);
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  .footer-tl-left {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.5vw, 16px);
  }
  .footer-tl-logo {
    width: clamp(40px, 5vw, 64px);
    height: auto;
    object-fit: contain;
  }
  .footer-tl-text {
    font-family: var(--font-display);
    font-size: clamp(16px, 3.5vw, 28px);
    color: var(--white);
    letter-spacing: 0.5px;
  }
  .footer-tl-meta {
    font-family: var(--font-mono);
    font-size: clamp(10px, 2vw, 18px);
    color: var(--muted);
    letter-spacing: 1.5px;
  }
</style>
</head>
<body data-tl-format="1080x1920">

{% set rachis_steps = parcours[q.rachis] if q.rachis in parcours else parcours.get("lombaire", []) %}
{% set patient_section = q.champs[0] %}
{% set chir_section = q.champs[1] if q.champs|length > 1 else q.champs[0] %}

<!-- =========================================
     SECTION 1 — Hero (header + identity + hero + frise)
     ========================================= -->
<section data-snap="true" class="section-hero">
  <div class="topbar">
    <img src="{{ logo_path }}" alt="Logo SRC" class="logo-tl">
    <div class="topbar-meta">#{{ q.numero_planche }}/{{ q.total_planches }}</div>
  </div>

  <div data-zone="header">
    <div class="questionnaire-tag">Questionnaire</div>
    <div class="code-huge">{{ q.id }}</div>
    <h1 class="title-tl">{{ q.titre }}</h1>
  </div>

  <div data-zone="identity">
    <div class="identity-cell-tl" data-field="etape">
      <span class="label-tl">Étape</span>
      <span class="value-tl">{{ q.etape_parcours }}</span>
    </div>
    <div class="identity-cell-tl">
      <span class="label-tl">Durée chir</span>
      <span class="value-tl">{{ q.duree_estimee_chir }}</span>
    </div>
    {% for qr in q.qui_remplit %}
      <div class="identity-cell-tl">
        <span class="label-tl">{{ qr.role|capitalize }}</span>
        <span class="value-tl">{{ qr.pourcentage }}%</span>
      </div>
    {% endfor %}
  </div>

  <div data-zone="hero">
    {% for path in abs_screenshots %}
      <img src="{{ path }}" alt="Follow {{ q.id }} part {{ loop.index }}" class="hero-screenshot">
    {% endfor %}
  </div>

  <div data-zone="frise">
    <div class="frise-flow-tl">
      {% for step in rachis_steps %}
        <span class="frise-step-tl{% if step.get('highlight') %} active{% endif %}">{{ step.id }}</span>
      {% endfor %}
    </div>
  </div>
</section>


<!-- =========================================
     SECTION 2 — Disrupteur
     ========================================= -->
<section data-snap="true" class="section-disrupteur">
  <div data-zone="disrupteur">
    <div class="disrupteur-tag-tl">Le chiffre</div>
    {% if '→' in q.disrupteur.phrase_principale %}
      {% set parts = q.disrupteur.phrase_principale.split('→') %}
      <div class="disrupteur-line">{{ parts[0]|trim }}</div>
      <div class="disrupteur-arrow-tl">→</div>
      <div class="disrupteur-line">{{ parts[1]|trim }}</div>
    {% else %}
      <div class="disrupteur-line">{{ q.disrupteur.phrase_principale }}</div>
    {% endif %}
    <p class="disrupteur-sec-tl">{{ q.disrupteur.phrase_secondaire }}</p>
  </div>
</section>


<!-- =========================================
     SECTION 3 — Les 4 décisions chir + rappel patient
     ========================================= -->
<section data-snap="true" class="section-decisions">
  <div class="section-tag">Pour toi</div>
  <h2 class="section-title-tl">{{ chir_section.section }}</h2>
  <ul class="decisions-list">
    {% for it in chir_section["items"] %}
      <li>{{ it }}</li>
    {% endfor %}
  </ul>
  <div class="patient-rappel">
    <div class="patient-rappel-label">Rappel — {{ patient_section.section }}</div>
    <div class="patient-rappel-content">
      {{ patient_section["items"] | join(' · ') }}
    </div>
  </div>
</section>


<!-- =========================================
     SECTION 4 — Pourquoi (gold) + footer
     ========================================= -->
<section data-snap="true" class="section-valeur">
  <div data-zone="valeur">
    <div class="valeur-tag">Pourquoi ça compte</div>
    <h2>{{ q.a_quoi_ca_sert.titre }}</h2>
    <ul>
      {% for p in q.a_quoi_ca_sert.points %}
        <li{% if loop.first %} class="first-point-tl"{% endif %}>{{ p }}</li>
      {% endfor %}
    </ul>
  </div>

  <div data-zone="footer">
    <div class="footer-tl-left">
      <img src="{{ logo_path }}" alt="Logo SRC" class="footer-tl-logo">
      <span class="footer-tl-text">Spine Research Community</span>
    </div>
    <span class="footer-tl-meta">{{ q.id }} · #{{ q.numero_planche }}/{{ q.total_planches }} · {{ today }}</span>
  </div>
</section>


<script>
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
      }
    }
  }, { threshold: 0.25 });
  document.querySelectorAll('section[data-snap="true"]').forEach(s => io.observe(s));
</script>

</body>
</html>
