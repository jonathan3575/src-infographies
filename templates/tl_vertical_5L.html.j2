<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ q.id }} — {{ q.titre }} · TL</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,600;1,9..40,300&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #080A0F;
    --bg2: #0E1117;
    --bg3: #141820;
    --teal: #00D4B4;
    --teal-dim: #00A890;
    --gold: #F0B429;
    --gold-dim: #C48F1A;
    --white: #F0EDE8;
    --muted: #6B7280;

    --font-display: 'Bebas Neue', sans-serif;
    --font-body: 'DM Sans', sans-serif;
    --font-mono: 'Space Mono', monospace;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; min-width: 0; }

  html, body {
    max-width: 100vw;
    margin: 0; padding: 0;
    background: var(--bg);
    color: var(--white);
    font-family: var(--font-body);
    font-size: clamp(14px, 3.5vw, 26px);
    line-height: 1.4;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  img { max-width: 100%; height: auto; display: block; }

  section[data-snap="true"] {
    width: 100%;
    max-width: 100vw;
    padding: 5vh 6vw;
    display: flex; flex-direction: column;
    gap: clamp(12px, 2vh, 24px);
    scroll-snap-align: start;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  section[data-snap="true"].visible { opacity: 1; transform: translateY(0); }

  /* HERO */
  .topbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .logo-tl { width: clamp(48px, 9vw, 88px); height: auto; object-fit: contain; }
  .topbar-meta {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.5vw, 22px);
    color: var(--muted);
    letter-spacing: 2px;
    text-align: right;
    white-space: nowrap;
  }
  [data-zone="header"] { display: flex; flex-direction: column; gap: clamp(4px, 1vh, 12px); }
  .questionnaire-tag {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.5vw, 28px);
    letter-spacing: clamp(2px, 1vw, 8px);
    color: var(--muted);
    text-transform: uppercase;
  }
  .code-huge {
    font-family: var(--font-display);
    font-size: clamp(80px, 22vw, 240px);
    line-height: 0.85;
    color: var(--teal);
    letter-spacing: 1px;
  }
  .title-tl {
    font-family: var(--font-display);
    font-size: clamp(26px, 7vw, 64px);
    line-height: 1;
    color: var(--white);
    letter-spacing: 0.5px;
    overflow-wrap: anywhere;
  }
  .sub-tl {
    font-size: clamp(14px, 3.2vw, 24px);
    color: var(--muted);
    font-style: italic;
    line-height: 1.3;
  }

  [data-zone="hero"] {
    background: var(--bg2);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 10px;
    padding: clamp(8px, 1.5vh, 14px);
    display: flex; align-items: center; justify-content: center;
  }
  .hero-screenshot {
    width: 100%; max-width: 100%; height: auto;
    object-fit: contain;
    background: var(--bg2);
    border-radius: 8px;
  }

  [data-zone="identity"] {
    background: var(--bg2);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 10px;
    padding: clamp(10px, 1.6vh, 16px) clamp(14px, 3vw, 24px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(12px, 3vw, 32px);
    row-gap: clamp(6px, 1.2vh, 12px);
  }
  .identity-cell-tl { display: flex; align-items: baseline; gap: clamp(6px, 1.5vw, 12px); flex-wrap: wrap; min-width: 0; }
  .identity-cell-tl .label-tl, .identity-cell-tl .value-tl { font-size: clamp(13px, 3vw, 24px); line-height: 1.2; }
  .identity-cell-tl .label-tl {
    font-family: var(--font-mono);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
  .identity-cell-tl .value-tl { font-weight: 600; color: var(--white); }

  [data-zone="frise"] {
    background: var(--bg3);
    padding: clamp(8px, 1.2vh, 12px) clamp(10px, 2.5vw, 20px);
    border-radius: 8px;
  }
  .frise-flow-tl { display: flex; flex-wrap: wrap; gap: clamp(4px, 0.8vw, 8px); align-items: center; }
  .frise-step-tl {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.2vw, 18px);
    color: var(--muted);
    padding: clamp(2px, 0.5vh, 5px) clamp(5px, 1.2vw, 10px);
    background: var(--bg2);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 4px;
    line-height: 1;
  }
  .frise-step-tl.active {
    color: var(--bg); background: var(--teal); border-color: var(--teal); font-weight: 700;
  }

  /* DISRUPTEUR */
  .section-disrupteur { padding: 10vh 6vw; }
  [data-zone="disrupteur"] {
    flex: 1;
    display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;
    gap: clamp(8px, 1.5vh, 16px);
  }
  .disrupteur-tag-tl {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.5vw, 28px);
    color: var(--muted);
    letter-spacing: clamp(2px, 1vw, 8px);
    text-transform: uppercase;
  }
  .disrupteur-num-tl {
    font-family: var(--font-display);
    font-size: clamp(120px, 30vw, 320px);
    line-height: 0.85;
    color: var(--gold);
    letter-spacing: 1px;
  }
  .disrupteur-unit-tl {
    font-family: var(--font-mono);
    font-size: clamp(14px, 3vw, 26px);
    color: var(--muted);
    letter-spacing: 4px;
    text-transform: uppercase;
    margin-bottom: clamp(8px, 2vh, 24px);
  }
  .disrupteur-main-tl {
    font-family: var(--font-display);
    font-size: clamp(40px, 10vw, 88px);
    line-height: 1;
    color: var(--white);
    letter-spacing: 0.5px;
    overflow-wrap: anywhere;
  }
  .disrupteur-sec-tl {
    font-size: clamp(16px, 4vw, 30px);
    color: var(--muted);
    margin-top: clamp(16px, 3vh, 40px);
    line-height: 1.4;
  }

  /* AXES */
  .section-axes { padding: 6vh 6vw; }
  .section-tag {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.5vw, 24px);
    letter-spacing: clamp(2px, 1vw, 8px);
    color: var(--muted);
    text-transform: uppercase;
  }
  .section-title-tl {
    font-family: var(--font-display);
    font-size: clamp(36px, 9vw, 72px);
    line-height: 1;
    color: var(--teal);
    letter-spacing: 0.5px;
    margin: clamp(4px, 0.8vh, 12px) 0 clamp(14px, 2vh, 22px) 0;
  }
  .axe-tl {
    background: var(--bg2);
    border-radius: 10px;
    padding: clamp(12px, 1.8vh, 18px) clamp(14px, 3vw, 22px);
    border-left: clamp(4px, 0.8vw, 6px) solid var(--teal);
    margin-bottom: clamp(8px, 1.4vh, 14px);
  }
  .axe-tl.critique { border-left-color: var(--gold); background: var(--bg3); }
  .axe-tl.normale { border-left-color: var(--muted); }
  .axe-title-tl {
    font-family: var(--font-display);
    font-size: clamp(22px, 5vw, 40px);
    color: var(--white);
    line-height: 1.05;
    letter-spacing: 0.3px;
    margin-bottom: clamp(4px, 0.8vh, 8px);
  }
  .axe-sub-tl {
    font-family: var(--font-mono);
    font-size: clamp(10px, 2vw, 16px);
    color: var(--muted);
    letter-spacing: 1px;
    margin-bottom: clamp(6px, 1.2vh, 12px);
  }

  /* AXE 1 — voies hiérarchisées */
  .voies-tl {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(8px, 1.4vh, 12px);
    margin-top: clamp(6px, 1vh, 10px);
  }
  .voie-card-tl {
    background: var(--bg);
    border-radius: 8px;
    padding: clamp(10px, 1.5vh, 14px) clamp(12px, 2.8vw, 20px);
    border: 1px solid rgba(0, 212, 180, 0.20);
  }
  .voie-name-tl {
    font-family: var(--font-display);
    font-size: clamp(40px, 10vw, 80px);
    line-height: 0.9;
    color: var(--teal);
    letter-spacing: 2px;
    margin-bottom: clamp(4px, 0.8vh, 8px);
    padding-bottom: clamp(4px, 0.8vh, 8px);
    border-bottom: 2px solid var(--teal);
  }
  .voie-items-tl {
    list-style: none;
    margin: 0; padding: 0;
  }
  .voie-items-tl li {
    font-size: clamp(13px, 2.8vw, 22px);
    color: var(--white);
    padding: clamp(2px, 0.4vh, 4px) 0;
    line-height: 1.3;
  }

  /* AXE 2 — schéma + items */
  .rachis-tl {
    display: grid;
    grid-template-columns: clamp(120px, 22vw, 200px) 1fr;
    gap: clamp(12px, 3vw, 24px);
    align-items: center;
    margin-top: clamp(4px, 0.8vh, 8px);
  }
  .rachis-svg-tl {
    width: 100%; height: auto;
    max-height: clamp(220px, 36vh, 360px);
  }
  .rachis-items-tl {
    list-style: none;
    margin: 0; padding: 0;
  }
  .rachis-items-tl li {
    font-family: var(--font-mono);
    font-size: clamp(13px, 2.8vw, 22px);
    color: var(--white);
    padding: clamp(6px, 1vh, 10px) 0;
    border-bottom: 1px dashed rgba(255,255,255,0.10);
    line-height: 1.3;
  }
  .rachis-items-tl li:last-child { border-bottom: 0; }

  /* AXES 3,4,5 — items inline */
  .axe-items-tl {
    list-style: none;
    margin: 0; padding: 0;
  }
  .axe-items-tl li {
    font-size: clamp(14px, 3vw, 24px);
    color: var(--white);
    padding: clamp(3px, 0.6vh, 6px) 0;
    line-height: 1.3;
  }
  .axe-items-tl li::before {
    content: "▹  ";
    color: var(--teal);
    font-weight: 700;
  }

  /* VALEUR + FOOTER */
  .section-valeur { padding: 8vh 6vw 4vh; }
  [data-zone="valeur"] {
    flex: 1;
    display: flex; flex-direction: column;
    background: rgba(240, 180, 41, 0.08);
    border-left: clamp(4px, 1vw, 8px) solid var(--gold);
    border-radius: 0 10px 10px 0;
    padding: clamp(20px, 4vh, 36px) clamp(16px, 4vw, 40px);
  }
  [data-zone="valeur"] .valeur-tag {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.5vw, 22px);
    letter-spacing: clamp(2px, 1vw, 6px);
    color: var(--muted);
    text-transform: uppercase;
  }
  [data-zone="valeur"] h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 8vw, 64px);
    line-height: 1;
    color: var(--gold);
    margin: clamp(4px, 0.8vh, 8px) 0 clamp(14px, 2vh, 24px) 0;
  }
  [data-zone="valeur"] ul { list-style: none; }
  [data-zone="valeur"] li {
    font-size: clamp(14px, 3.2vw, 26px);
    line-height: 1.4;
    color: var(--white);
    padding: clamp(8px, 1.4vh, 14px) 0;
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  [data-zone="valeur"] li:last-child { border-bottom: 1px solid rgba(255,255,255,0.07); }
  [data-zone="valeur"] li.first-point-tl {
    font-family: var(--font-display);
    font-size: clamp(24px, 6vw, 44px);
    line-height: 1.05;
    color: var(--white);
    background: rgba(240, 180, 41, 0.18);
    padding: clamp(14px, 2.5vh, 22px) clamp(14px, 3vw, 24px);
    margin: 0 0 clamp(8px, 1.5vh, 12px) 0;
    border-left: clamp(4px, 1vw, 6px) solid var(--gold);
    border-radius: 0 8px 8px 0;
    border-top: 0;
  }
  .note-finale-tl {
    margin-top: clamp(10px, 1.8vh, 16px);
    font-family: var(--font-mono);
    font-size: clamp(12px, 2.4vw, 20px);
    color: var(--muted);
    letter-spacing: 1px;
    text-align: center;
    padding: clamp(8px, 1.5vh, 14px) 0;
    border-top: 1px dashed rgba(255,255,255,0.10);
    border-bottom: 1px dashed rgba(255,255,255,0.10);
  }
  [data-zone="footer"] {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px;
    padding-top: clamp(12px, 2vh, 16px);
    margin-top: clamp(10px, 1.8vh, 20px);
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  .footer-tl-left { display: flex; align-items: center; gap: clamp(8px, 1.5vw, 16px); }
  .footer-tl-logo { width: clamp(40px, 5vw, 64px); height: auto; object-fit: contain; }
  .footer-tl-text {
    font-family: var(--font-display);
    font-size: clamp(16px, 3.5vw, 26px);
    color: var(--white);
    letter-spacing: 0.5px;
  }
  .footer-tl-meta {
    font-family: var(--font-mono);
    font-size: clamp(10px, 2vw, 18px);
    color: var(--muted);
    letter-spacing: 1.5px;
  }
</style>
</head>
<body data-tl-format="1080x1920">

{% set rachis_steps = parcours[q.rachis] if q.rachis in parcours else parcours.get("lombaire", []) %}

<!-- SECTION 1 — Hero (header + photo + identity + frise) -->
<section data-snap="true" class="section-hero">
  <div class="topbar">
    <img src="{{ logo_path }}" alt="Logo SRC" class="logo-tl">
    <div class="topbar-meta">#{{ q.numero_planche }}/{{ q.total_planches }}</div>
  </div>

  <div data-zone="header">
    <div class="questionnaire-tag">Questionnaire</div>
    <div class="code-huge">{{ q.id }}</div>
    <h1 class="title-tl">{{ q.titre }}</h1>
    <p class="sub-tl">{{ q.sous_titre }}</p>
  </div>

  <div data-zone="hero">
    {% for path in abs_screenshots %}
      <img src="{{ path }}" alt="Follow {{ q.id }} part {{ loop.index }}" class="hero-screenshot">
    {% endfor %}
  </div>

  <div data-zone="identity">
    <div class="identity-cell-tl" data-field="etape">
      <span class="label-tl">Étape</span>
      <span class="value-tl">{{ q.etape_parcours }}</span>
    </div>
    <div class="identity-cell-tl">
      <span class="label-tl">Durée chir</span>
      <span class="value-tl">{{ q.duree_estimee_chir }}</span>
    </div>
    {% for qr in q.qui_remplit %}
      <div class="identity-cell-tl">
        <span class="label-tl">{{ qr.role|capitalize }}</span>
        <span class="value-tl">{{ qr.pourcentage }}%</span>
      </div>
    {% endfor %}
  </div>

  <div data-zone="frise">
    <div class="frise-flow-tl">
      {% for step in rachis_steps %}
        <span class="frise-step-tl{% if step.id == q.id %} active{% endif %}">{{ step.id }}</span>
      {% endfor %}
    </div>
  </div>
</section>


<!-- SECTION 2 — Disrupteur -->
<section data-snap="true" class="section-disrupteur">
  <div data-zone="disrupteur">
    <div class="disrupteur-tag-tl">Le chiffre</div>
    <div class="disrupteur-num-tl">{{ q.disrupteur.chiffre }}</div>
    <div class="disrupteur-unit-tl">{{ q.disrupteur.unite }}</div>
    <div class="disrupteur-main-tl">{{ q.disrupteur.phrase_principale }}</div>
    <p class="disrupteur-sec-tl">{{ q.disrupteur.phrase_secondaire }}</p>
  </div>
</section>


<!-- SECTION 3 — Axe 1 + Axe 2 -->
<section data-snap="true" class="section-axes">
  <div class="section-tag">Pour toi</div>
  <h2 class="section-title-tl">Voie d'abord + niveaux</h2>

  {% set ax1 = q.axes[0] %}
  <div class="axe-tl {{ ax1.criticite }}">
    <div class="axe-title-tl">{{ ax1.nom }}</div>
    {% if ax1.sous_titre %}<div class="axe-sub-tl">{{ ax1.sous_titre }}</div>{% endif %}
    <div class="voies-tl">
      {% for v in ax1.voies %}
        <div class="voie-card-tl">
          <div class="voie-name-tl">{{ v.voie }}</div>
          <ul class="voie-items-tl">
            {% for it in v["items"] %}<li>{{ it }}</li>{% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>
  </div>

  {% set ax2 = q.axes[1] %}
  <div class="axe-tl {{ ax2.criticite }}">
    <div class="axe-title-tl">{{ ax2.nom }}</div>
    <div class="rachis-tl">
      <svg class="rachis-svg-tl" viewBox="0 0 100 140" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="vert-tl" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#F0EDE8"/>
            <stop offset="100%" stop-color="#6B7280"/>
          </linearGradient>
        </defs>
        {% set levels = ["T12", "L1", "L2", "L3", "L4", "L5", "S1"] %}
        {% for lvl in levels %}
          {% set y = 8 + loop.index0 * 18 %}
          <rect x="30" y="{{ y }}" width="38" height="12" rx="3" ry="3"
                fill="url(#vert-tl)" stroke="#00D4B4" stroke-width="0.8"/>
          {% if not loop.last %}
            <rect x="34" y="{{ y + 12 }}" width="30" height="4" rx="1.5" ry="1.5"
                  fill="#00D4B4" opacity="0.5"/>
          {% endif %}
          <text x="74" y="{{ y + 9 }}" font-family="Space Mono, monospace"
                font-size="7" fill="#F0EDE8">{{ lvl }}</text>
        {% endfor %}
      </svg>
      <ul class="rachis-items-tl">
        {% for it in ax2["items"] %}<li>{{ it }}</li>{% endfor %}
      </ul>
    </div>
  </div>
</section>


<!-- SECTION 4 — Axes 3, 4, 5 -->
<section data-snap="true" class="section-axes">
  <div class="section-tag">Suite</div>
  <h2 class="section-title-tl">Matériel · antécédent · séjour</h2>

  {% for ax in q.axes[2:] %}
    <div class="axe-tl {{ ax.criticite }}">
      <div class="axe-title-tl">{{ ax.nom }}</div>
      <ul class="axe-items-tl">
        {% for it in ax["items"] %}<li>{{ it }}</li>{% endfor %}
      </ul>
    </div>
  {% endfor %}
</section>


<!-- SECTION 5 — Valeur + footer -->
<section data-snap="true" class="section-valeur">
  <div data-zone="valeur">
    <div class="valeur-tag">Pourquoi ça compte</div>
    <h2>{{ q.a_quoi_ca_sert.titre }}</h2>
    <ul>
      {% for p in q.a_quoi_ca_sert.points %}
        <li{% if loop.first %} class="first-point-tl"{% endif %}>{{ p }}</li>
      {% endfor %}
    </ul>
  </div>

  {% if q.note_finale %}
  <div class="note-finale-tl">{{ q.note_finale }}</div>
  {% endif %}

  <div data-zone="footer">
    <div class="footer-tl-left">
      <img src="{{ logo_path }}" alt="Logo SRC" class="footer-tl-logo">
      <span class="footer-tl-text">Spine Research Community</span>
    </div>
    <span class="footer-tl-meta">{{ q.id }} · #{{ q.numero_planche }}/{{ q.total_planches }} · {{ today }}</span>
  </div>
</section>


<script>
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) e.target.classList.add('visible');
    }
  }, { threshold: 0.25 });
  document.querySelectorAll('section[data-snap="true"]').forEach(s => io.observe(s));
</script>

</body>
</html>
